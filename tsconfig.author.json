{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/sharddev/**/*.ts",
    "src/sharddev/**/*.mts",
    "src/commons/**/*.ts",
    "test/graph-scene-author-types.test.ts",
    "node_modules/@wildshard/engine/src/*/engine/**/*.d.ts",
    "node_modules/@wildshard/engine/src/*/game/**/*.merge.d.ts"
  ],
  "exclude": [
    "src/sharddev/**/*.test.ts",
    "src/sharddev/test",
    "src/commons/**/*.test.ts"
  ]
}
