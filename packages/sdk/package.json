{
  "name": "@wildshard/sdk",
  "version": "0.3.9",
  "description": "The author library: scene source, rows, random, noise, the bake builders, script compile and schemas (SDK-SPLIT). The `wildshard` CLI and the local game are @wildshard/dev until SP10 gives the bin its own package.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-wildshard/sharddev.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "files": [
    ".oxlintrc.author.json",
    "GUIDE.md",
    "docs/api/EXPORT-TIERS.md",
    "skills",
    "codemods",
    "src",
    "!src/**/*.test.*",
    "!src/shards/ink-cel-valley",
    "!src/shards/pastel-plain",
    "scripts",
    "!scripts/**/*.test.*",
    "!scripts/docs",
    "!scripts/entry-reads/tsconfig.json",
    "lint",
    "!lint/**/*.test.*",
    "tsconfig*.json",
    "!src/.oxlintrc.json"
  ],
  "scripts": {
    "docs": "node scripts/docs.mjs",
    "lint:kit": "node ../../kit/scripts/lint.mjs --type-aware --deny-warnings --ignore-pattern 'src/sharddev/**' --ignore-pattern 'src/commons/**' --ignore-pattern 'src/shards/**' --no-error-on-unmatched-pattern src",
    "lint:author": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node ../../kit/scripts/bin-tools.mjs -c .oxlintrc.author.json --deny-warnings src/sharddev src/commons src/shards codemods",
    "lint:ci21": "node scripts/ci21-sdk-tail-lint.mjs",
    "test": "pnpm test:author",
    "test:author": "vitest run",
    "build:shards": "node scripts/publish-public.mjs && node ../dev/bin/wildshard.mjs build-shards",
    "pack:shards": "node scripts/pack-all.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
