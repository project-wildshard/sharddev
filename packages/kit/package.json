{
  "name": "@wildshard/kit",
  "version": "0.5.1",
  "description": "Shared creature content and helpers for the one shard format.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-wildshard/sharddev.git",
    "directory": "packages/kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "content",
    "GUIDE.md",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./creatures": "./src/creatures.ts",
    "./body": "./src/body.ts",
    "./skeletons": "./src/skeletons.ts",
    "./legacySpecies": "./src/legacySpecies.ts",
    "./legacyHarvest": "./src/legacyHarvest.ts",
    "./legacyCombat": "./src/legacyCombat.ts",
    "./temperament": "./src/temperament.ts",
    "./abilities": "./src/abilities.ts",
    "./clips": "./src/clips.ts",
    "./content/*": "./content/*",
    "./geometry/*": "./src/geometry/*.ts",
    "./arms": "./src/geometry/arms.ts",
    "./sharedSpecs": "./src/geometry/sharedSpecs.ts",
    "./weapons/starterMeleeProfile": "./src/geometry/starterMeleeProfile.ts",
    "./weapons/starterMoves": "./src/geometry/starterMoves.ts",
    "./bake/species": "./src/geometry/species.ts",
    "./bake/riderArms": "./src/geometry/riderArms.ts",
    "./bake/specimenCatalogue": "./src/geometry/specimenCatalogue.ts",
    "./bake/nativeInteractionFacts": "./src/geometry/nativeInteractionFacts.ts",
    "./weapons/meleeProfile": "./src/geometry/meleeProfile.ts",
    "./weapons/bowProfile": "./src/geometry/bowProfile.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:skeletons": "node --import ./test-hook.mjs scripts/build-skeletons.ts",
    "build:wildlife": "node --import ./test-hook.mjs scripts/build-wildlife.ts",
    "test": "node --import ./test-hook.mjs --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@wildshard/shard-format": "0.78.0",
    "valibot": "1.5.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@types/node": "24.3.1",
    "@types/three": "0.186.0",
    "@wildshard/sdk": "workspace:*",
    "meshoptimizer": "1.2.0"
  },
  "peerDependencies": {
    "@wildshard/sdk": ">=0.3.2 <1.0.0"
  }
}
