{
  "name": "@wildshard/kit",
  "version": "0.1.0",
  "description": "Shared creature content and helpers for the one shard format.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-wildshard/sharddev.git",
    "directory": "packages/kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "content",
    "GUIDE.md",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./body": "./src/body.ts",
    "./temperament": "./src/temperament.ts",
    "./abilities": "./src/abilities.ts",
    "./content/*": "./content/*",
    "./geometry/*": "./src/geometry/*.ts",
    "./arms": "./src/geometry/arms.ts",
    "./sharedSpecs": "./src/geometry/sharedSpecs.ts",
    "./weapons/starterMeleeProfile": "./src/geometry/starterMeleeProfile.ts",
    "./weapons/starterMoves": "./src/geometry/starterMoves.ts",
    "./bake/species": "./src/geometry/species.ts",
    "./bake/riderArms": "./src/geometry/riderArms.ts",
    "./bake/specimenCatalogue": "./src/geometry/specimenCatalogue.ts",
    "./bake/nativeInteractionFacts": "./src/geometry/nativeInteractionFacts.ts",
    "./weapons/meleeProfile": "./src/geometry/meleeProfile.ts",
    "./weapons/bowProfile": "./src/geometry/bowProfile.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/catalogue.test.ts 'src/geometry/*.test.ts'"
  },
  "dependencies": {
    "@wildshard/shard-format": "^0.6.0",
    "valibot": "^1.2.0",
    "three": "0.186.0"
  },
  "peerDependencies": {
    "@wildshard/sdk": "^0.3.2"
  }
}
