{
  "name": "@wildshard/cli",
  "version": "0.9.1",
  "description": "The `wildshard` command (SDK-SPLIT SP10): one install brings build, upload and dev (the local game and the engine). `build` runs @wildshard/build's compiled bin and never loads the engine; every other verb loads dev's CLI lazily.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-wildshard/sharddev.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "bin": {
    "wildshard": "./bin/wildshard.mjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@wildshard/build": "workspace:*",
    "@wildshard/dev": "workspace:*",
    "@wildshard/upload": "workspace:*"
  },
  "devDependencies": {
    "@wildshard/sdk": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
