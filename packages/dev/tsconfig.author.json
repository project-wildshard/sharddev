{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/sharddev/**/*.ts",
    "src/sharddev/**/*.mts",
    "node_modules/@wildshard/engine/src/*/engine/**/*.d.ts",
    "node_modules/@wildshard/engine/src/*/game/**/*.merge.d.ts"
  ],
  "exclude": [
    "src/sharddev/**/*.test.ts",
    "src/sharddev/test"
  ],
  "files": [
    "test/scripts/_template-boss.test.ts",
    "src/sharddev/test/scriptScenario.ts",
    "src/sharddev/test/diskScriptScenario.ts"
  ]
}
