{
  "name": "@wildshard/sharddev-workspace",
  "version": "0.4.27",
  "private": true,
  "description": "sharddev workspace root: repo tooling only. The packages live in packages/* (SDK-SPLIT); the version here is the one release version all of them share (D5).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-wildshard/sharddev.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "pnpm:devPreinstall": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @wildshard/dev run dev",
    "build": "pnpm --filter @wildshard/dev run build",
    "typecheck": "node scripts/typecheck.mjs",
    "release:stamp": "node scripts/release-workspace.mjs stamp",
    "docs": "pnpm --filter @wildshard/sdk run docs",
    "lint": "node scripts/lint-dispatch.mjs",
    "lint:kit": "node kit/scripts/lint.mjs --type-aware --deny-warnings --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'tmp/**' --ignore-pattern 'packages/sdk/**' --ignore-pattern 'packages/dev/**' --ignore-pattern 'packages/build/**' --ignore-pattern 'packages/cli/**' --ignore-pattern 'packages/upload/src/sharddev/**' --ignore-pattern 'packages/kit/src/**' --ignore-pattern 'scripts/**' --ignore-pattern 'test/**' --no-error-on-unmatched-pattern",
    "lint:sdk": "pnpm --filter @wildshard/sdk run lint:kit",
    "lint:author": "WILDSHARD_RATCHET_FILE=packages/sdk/lint/ratchet.json node kit/scripts/bin-tools.mjs -c .oxlintrc.packages.json --deny-warnings packages/upload/src/sharddev packages/kit/src",
    "lint:sdk-author": "pnpm --filter @wildshard/sdk run lint:author",
    "lint:fix": "node kit/scripts/lint.mjs --type-aware --fix --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**' --ignore-pattern 'packages/sdk/**' --ignore-pattern 'packages/dev/**' --ignore-pattern 'packages/build/**' --ignore-pattern 'packages/cli/**' --ignore-pattern 'packages/upload/src/sharddev/**' --ignore-pattern 'packages/kit/src/**' --ignore-pattern 'scripts/**' --ignore-pattern 'test/**'",
    "format": "npr oxfmt -c kit/.oxfmtrc.json kit packages/sdk/src packages/dev/src packages/upload/src packages/kit/src packages/build/src",
    "format:check": "npr oxfmt -c kit/.oxfmtrc.json --check kit packages/sdk/src packages/dev/src packages/upload/src packages/kit/src packages/build/src",
    "test": "pnpm test:kit && pnpm test:author && pnpm test:content",
    "test:ci": "pnpm --filter @wildshard/dev run test:ci",
    "test:e2e": "pnpm --filter @wildshard/dev run test:e2e",
    "test:kit": "pnpm --filter @wildshard/dev run test:kit && node --test 'packages/upload/src/**/*.test.ts' test/tooling/one-format.test.mjs",
    "test:author": "pnpm --filter @wildshard/sdk run test:author && pnpm --filter @wildshard/build run test:author && pnpm --filter @wildshard/dev run test:author && pnpm --filter @wildshard/cli test",
    "test:content": "pnpm --dir packages/kit test",
    "check:asks": "node kit/scripts/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node scripts/agent-parity.mjs --strict",
    "check:agent-sync": "node scripts/agent-sync.mjs --check",
    "test:agent-hooks": "node --test '.agents/hooks/test/*.test.mjs'",
    "agents:sync": "node scripts/agent-sync.mjs",
    "md:wrap": "node kit/scripts/md-wrap.mjs",
    "test:hooks": "node --test '.githooks/*.test.mjs'",
    "check": "pnpm check:bin-pins && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:watch-build && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm test:agent-hooks && pnpm check:parity && node --check scripts/chromium-keychain-check.mjs && node --test test/tooling/chrome-keychain.test.mjs test/tooling/format-api-gate.test.mjs test/tooling/worktree-guard.test.mjs test/tooling/disk-land.test.mjs test/tooling/lane-live.test.mjs test/tooling/keep-copy.test.mjs test/tooling/leftovers-report.test.mjs test/tooling/reap-report.test.mjs test/tooling/sdk-exports.test.mjs && node scripts/sdk-exports.mjs check",
    "check:watch-build": "pnpm --filter @wildshard/dev run check:watch-build",
    "typecheck:kit": "npr tsc -p packages/sdk/src/tsconfig.json && npr tsc -p packages/dev/src/tsconfig.json && npr tsc -p packages/dev/src/web/tsconfig.json",
    "typecheck:author": "npr tsc -p packages/sdk/tsconfig.author.json && npr tsc -p packages/build/tsconfig.author.json && npr tsc -p packages/dev/tsconfig.author.json",
    "build:shards": "pnpm --filter @wildshard/sdk run build:shards",
    "pack:shards": "pnpm --filter @wildshard/sdk run pack:shards",
    "lint:ci21": "pnpm --filter @wildshard/sdk run lint:ci21",
    "check:bin-pins": "node kit/scripts/bin-pins.mjs",
    "lint:dev": "pnpm --filter @wildshard/dev run lint:kit",
    "lint:dev-author": "pnpm --filter @wildshard/dev run lint:author"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "npm-bin-deps": "2.1.0",
    "oxlint": "1.89.0"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@esbuild/aix-ppc64",
      "@esbuild/android-arm",
      "@esbuild/android-arm64",
      "@esbuild/android-x64",
      "@esbuild/darwin-x64",
      "@esbuild/freebsd-arm64",
      "@esbuild/freebsd-x64",
      "@esbuild/linux-arm",
      "@esbuild/linux-arm64",
      "@esbuild/linux-ia32",
      "@esbuild/linux-loong64",
      "@esbuild/linux-mips64el",
      "@esbuild/linux-ppc64",
      "@esbuild/linux-riscv64",
      "@esbuild/linux-s390x",
      "@esbuild/netbsd-arm64",
      "@esbuild/netbsd-x64",
      "@esbuild/openbsd-arm64",
      "@esbuild/openbsd-x64",
      "@esbuild/openharmony-arm64",
      "@esbuild/sunos-x64",
      "@esbuild/win32-arm64",
      "@esbuild/win32-ia32",
      "@esbuild/win32-x64",
      "@oxfmt/binding-android-arm-eabi",
      "@oxfmt/binding-android-arm64",
      "@oxfmt/binding-darwin-x64",
      "@oxfmt/binding-freebsd-x64",
      "@oxfmt/binding-linux-arm-gnueabihf",
      "@oxfmt/binding-linux-arm-musleabihf",
      "@oxfmt/binding-linux-arm64-gnu",
      "@oxfmt/binding-linux-arm64-musl",
      "@oxfmt/binding-linux-ppc64-gnu",
      "@oxfmt/binding-linux-riscv64-gnu",
      "@oxfmt/binding-linux-riscv64-musl",
      "@oxfmt/binding-linux-s390x-gnu",
      "@oxfmt/binding-linux-x64-musl",
      "@oxfmt/binding-openharmony-arm64",
      "@oxfmt/binding-win32-arm64-msvc",
      "@oxfmt/binding-win32-ia32-msvc",
      "@oxfmt/binding-win32-x64-msvc",
      "@oxlint-tsgolint/darwin-x64",
      "@oxlint-tsgolint/linux-arm64",
      "@oxlint-tsgolint/win32-arm64",
      "@oxlint-tsgolint/win32-x64",
      "@oxlint/binding-android-arm-eabi",
      "@oxlint/binding-android-arm64",
      "@oxlint/binding-darwin-x64",
      "@oxlint/binding-freebsd-x64",
      "@oxlint/binding-linux-arm-gnueabihf",
      "@oxlint/binding-linux-arm-musleabihf",
      "@oxlint/binding-linux-arm64-gnu",
      "@oxlint/binding-linux-arm64-musl",
      "@oxlint/binding-linux-ppc64-gnu",
      "@oxlint/binding-linux-riscv64-gnu",
      "@oxlint/binding-linux-riscv64-musl",
      "@oxlint/binding-linux-s390x-gnu",
      "@oxlint/binding-linux-x64-musl",
      "@oxlint/binding-openharmony-arm64",
      "@oxlint/binding-win32-arm64-msvc",
      "@oxlint/binding-win32-ia32-msvc",
      "@oxlint/binding-win32-x64-msvc",
      "@typescript/typescript-aix-ppc64",
      "@typescript/typescript-darwin-x64",
      "@typescript/typescript-freebsd-arm64",
      "@typescript/typescript-freebsd-x64",
      "@typescript/typescript-linux-arm",
      "@typescript/typescript-linux-loong64",
      "@typescript/typescript-linux-mips64el",
      "@typescript/typescript-linux-ppc64",
      "@typescript/typescript-linux-riscv64",
      "@typescript/typescript-linux-s390x",
      "@typescript/typescript-netbsd-arm64",
      "@typescript/typescript-netbsd-x64",
      "@typescript/typescript-openbsd-arm64",
      "@typescript/typescript-openbsd-x64",
      "@typescript/typescript-sunos-x64",
      "@typescript/typescript-win32-arm64",
      "@typescript/typescript-win32-x64"
    ],
    "overrides": {
      "binaryen": "npm:@pre-bundled/binaryen@132.0.0-patch-1",
      "assemblyscript>binaryen": "npm:@pre-bundled/binaryen@131.0.0-nightly.20260721-patch-1",
      "@wildshard/format": "npm:@wildshard/shard-format@0.71.0"
    }
  },
  "binDependencies": {
    "typescript": "7.0.2",
    "oxfmt": "0.74.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "binDependenciesInstaller": "npm"
}
