{
  "name": "@wildshard/sharddev",
  "version": "0.0.0",
  "private": true,
  "description": "The author's toolbox: the `wildshard` CLI that bakes shard source into a shardfile, the author SDK, the local dev server (engine client against engine server), the explorers, arena and drafts tool.",
  "type": "module",
  "bin": {
    "sharddev": "./bin/wildshard.mjs",
    "wildshard": "./bin/wildshard.mjs"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "pnpm:devPreinstall": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node src/tools/build-web.ts --dev",
    "build": "node src/tools/build-web.ts",
    "typecheck": "pnpm typecheck:kit && pnpm typecheck:author",
    "lint": "oxlint -c src/.oxlintrc.json --type-aware --deny-warnings --ignore-pattern '.githooks/**' --ignore-pattern 'tmp/**' --ignore-pattern 'vitest.config.ts' --ignore-pattern 'src/sharddev/**' --ignore-pattern 'src/commons/**' --ignore-pattern 'src/shards/**' --ignore-pattern 'public/**' --ignore-pattern 'scripts/**' --ignore-pattern 'test/**' --ignore-pattern 'drafts/**' --ignore-pattern 'lint/**' --ignore-pattern 'vite/**' --ignore-pattern 'bin/**' --no-error-on-unmatched-pattern && pnpm lint:author",
    "lint:fix": "oxlint -c src/.oxlintrc.json --type-aware --fix --ignore-pattern '.githooks/**' --ignore-pattern 'tmp/**' --ignore-pattern 'vitest.config.ts' --ignore-pattern 'src/sharddev/**' --ignore-pattern 'src/commons/**' --ignore-pattern 'src/shards/**' --ignore-pattern 'public/**' --ignore-pattern 'scripts/**' --ignore-pattern 'test/**' --ignore-pattern 'drafts/**' --ignore-pattern 'lint/**' --ignore-pattern 'vite/**' --ignore-pattern 'bin/**'",
    "format": "oxfmt -c src/.oxfmtrc.json src",
    "format:check": "oxfmt -c src/.oxfmtrc.json --check src",
    "test": "pnpm test:kit && pnpm test:author",
    "test:ci": "node --test 'src/ci/**/*.test.ts'",
    "test:e2e": "playwright test --config src/e2e/playwright.config.ts",
    "check:asks": "node src/scripts/asks.mjs check",
    "md:wrap": "node src/scripts/md-wrap.mjs",
    "test:hooks": "node --test '.githooks/*.test.mjs'",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:asks",
    "typecheck:kit": "tsc -p src/tsconfig.json && tsc -p src/web/tsconfig.json",
    "typecheck:author": "tsc -p tsconfig.author.json",
    "lint:author": "WILDSHARD_RATCHET_FILE=lint/ratchet.json oxlint -c .oxlintrc.author.json --deny-warnings src/sharddev src/commons src/shards",
    "test:kit": "node --test 'src/cli/**/*.test.ts' 'src/server/*.test.ts' 'src/test/**/*.test.ts'",
    "test:author": "vitest run",
    "build:shards": "node scripts/publish-public.mjs && node bin/wildshard.mjs build-shards",
    "pack:shards": "node scripts/pack-all.mjs"
  },
